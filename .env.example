APP_NAME=IAssis Pianos
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true

# Banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iassis
DATABASE_STATEMENT_TIMEOUT_MS=30000
AUTO_CREATE_TABLES=false
SCHEDULER_ENABLED=true

# API security
BACKEND_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
AUTH_REQUIRED=true
AUTH_SECRET_KEY=troque_essa_chave_em_producao
AUTH_BOOTSTRAP_TOKEN=troque_este_token_bootstrap
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_PASSWORD_ITERATIONS=390000
AUTH_BOOTSTRAP_ADMIN=true
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@assis.local
INITIAL_ADMIN_PASSWORD=troque_essa_senha

# Dados oficiais da empresa (usados nos documentos gerados)
COMPANY_NAME=JR NASCIMENTOS VENDA E CONSERTO DE INSTRUMENTOS MUSICAIS LTDA.
COMPANY_CNPJ=09.481.301/0001-59
COMPANY_CNPJ_CONTRATO=09.481.301/0002-30
COMPANY_CPF_SOCIO=408.321.983-15
COMPANY_ADDRESS=Av. Rui Barbosa, 780 lj.10 - Meireles - Fortaleza - CE
COMPANY_PHONE=(85) 3067-1283 / 99622-4480
COMPANY_EMAIL=otpianos@yahoo.com.br / assispianos@hotmail.com
COMPANY_RESPONSAVEL=Francisco de Assis do Nascimento Jr.

DEFAULT_BUDGET_VALID_DAYS=7

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=iassis_bot
EVOLUTION_API_TIMEOUT_SECONDS=10
WHATSAPP_WEBHOOK_TOKEN=troque_este_webhook_token
WHATSAPP_LID_MAP_JSON=
EVOLUTION_AUTHENTICATION_API_KEY=
EVOLUTION_DATABASE_CONNECTION_URI=

# Telefone que recebe o resumo diario as 7h (formato: 5585999999999)
WHATSAPP_NOTIFY_PHONE=
